<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- POM parent : versions, plugins et réglages communs à tous les modules -->
    <groupId>tn.supcom.eburseal</groupId>
    <artifactId>eburseal-parent</artifactId>
    <version>0.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>EburSeal — parent</name>

    <!-- Ordre indicatif : Maven calcule lui-même l'ordre à partir des dépendances -->
    <modules>
        <module>commun</module>
        <module>crypto</module>
        <module>moteur</module>
        <module>banc</module>
        <module>api</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jakartaee.version>11.0.0</jakartaee.version>
        <junit.version>5.12.2</junit.version>
    </properties>

    <!-- Versions déclarées une seule fois ; chaque module choisit ce qu'il utilise -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>tn.supcom.eburseal</groupId>
                <artifactId>commun</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tn.supcom.eburseal</groupId>
                <artifactId>crypto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>tn.supcom.eburseal</groupId>
                <artifactId>moteur</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.platform</groupId>
                <artifactId>jakarta.jakartaee-api</artifactId>
                <version>${jakartaee.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- JUnit pour tous les modules -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
